# Set the actual Coda-compatible endpoint before running configure.py.
LLM_BASE_URL=https://your-translation-api.example/v1
LLM_MODEL=Coda-V2
# configure.py prompts for the secret and writes a private .env file.
LLM_API_KEY=
OCR_DETECTION_MODEL=PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec
OCR_CPU_THREADS=4
NUQTA_BASE_URL=http://127.0.0.1:8116
ARABIC_DETECTION_SCALE=2
NUQTA_MAX_REGIONS=64
NUQTA_IMAGE_TIMEOUT=120
DATA_RETENTION_HOURS=24
MAX_JOBS_PER_IP_HOUR=12
MAX_JOBS_PER_DAY=100
